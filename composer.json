{
    "name": "adnanmula/keyforge-game-log-parser",
    "description": "",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Adnan Mula",
            "email": "adnan.mula.bakkar@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/dom-crawler": "^7.2 || ^8.0",
        "symfony/css-selector": "^7.2 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "symfony/var-dumper": "^7.0 || ^8.0",
        "phpro/grumphp": "^2.5",
        "adnanmula/coding-standard": "^0.0.13",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "post-install-cmd": [
          "@auto-scripts"
        ],
        "post-update-cmd": [
          "@auto-scripts"
        ],
        "post-autoload-dump": [
          "rm -rf .git/hooks",
          "cp -r scripts/git-hooks .git/hooks"
        ]
    },
    "autoload": {
        "psr-4": {
            "AdnanMula\\KeyforgeGameLogParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdnanMula\\KeyforgeGameLogParser\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true
        }
    }
}
